rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuários - qualquer um pode ler, só o dono edita
    match /usuarios/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Ninguém deleta
    }
    
    // Vagas - qualquer um pode ver, autenticados criam
    match /vagas/{vagaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // Conexões - só autenticados
    match /conexoes/{connId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Mensagens - só autenticados
    match /mensagens/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // Notificações - só autenticados
    match /notificacoes/{notId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Avaliações - leitura pública, criação autenticada
    match /avaliacoes/{avalId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
    
    // Regra padrão para o resto
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
  }
}rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Permite leitura para qualquer um (para teste)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Usuários
    match /usuarios/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    
    // Vagas
    match /vagas/{vagaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    // Conexões
    match /conexoes/{connId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    // Mensagens
    match /mensagens/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    // Notificações
    match /notificacoes/{notId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    // Avaliações
    match /avaliacoes/{avalId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
